# ==========================================
# Premium Turkey Education Platform - Environment Configuration
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
# For Local Dev with SQLite:
DATABASE_URL="file:./dev.db"
# For Production with PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/turkey_education_db?schema=public"

JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Storage Configuration
UPLOAD_DIR=./uploads
PRIVATE_DOCS_DIR=./storage/private_documents

# Optional Cloudinary Configuration for Media Assets
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
