# Server Port
PORT=5000

# Environment: development / production
NODE_ENV=production

# Database URL:
# For SQLite: "file:./dev.db"
# For PostgreSQL (Production): "postgresql://postgres:password@localhost:5432/turkey_education?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_string_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated or single domain)
CORS_ORIGIN=https://yourdomain.com,http://localhost:5173

# File Storage Directories
UPLOAD_DIR=./uploads
PRIVATE_DOCS_DIR=./storage/private_documents
